bin/
obj/
*.user
.vs/
.idea/
publish/

# Artefacts de publication : exécutables, archive portable, MSI.
# Ils se reconstruisent avec build\publish.ps1 et installer\build-msi.ps1 —
# les versionner alourdirait le dépôt de centaines de Mo (GitHub refuse les
# fichiers > 100 Mo et alerte au-delà de 50 Mo). Pour les distribuer :
# passer par une Release GitHub.
dist/
*.msi
*.wixpdb
*.zip

# ---------------------------------------------------------------------------
# SORTIES DU LOGICIEL — À NE JAMAIS VERSIONNER
#
# FaultTracePC écrit ses rapports dans Documents\FaultTracePC, qui est aussi
# le dossier de développement : sans ces règles, des données personnelles de
# la machine analysée (matériel, processus, historique de pannes, journaux
# PowerShell) et surtout des SECRETS (tokens d'accès dans parc.json) se
# retrouvent dans le dépôt.
# ---------------------------------------------------------------------------
Diagnostic_*.html
Diagnostic_*.pdf
Parc_*.html
Reparation_PC_*.ps1
Reparation_PC_*.bat
Reparation_log_*.txt
# Journaux de compilation (build.log / test.log via Tee-Object).
# Note : .gitignore n'accepte PAS de commentaire en fin de ligne — le texte
# ferait partie du motif. Toujours sur une ligne dédiée.
*.log
rapport-*.html
inventaire_pilotes.txt
MajWindows_*.txt
maj.txt
# Préférence de langue, par utilisateur (Documents\FaultTracePC\langue.txt).
langue.txt

# Historique des scans (résumés machine) et configuration locale
Historique/
parc.json
remote.json
alerts.json
*.jsonl

# Réglages de la console de parc (parametres.json). Ce fichier ne contient
# AUCUN secret — c'est une décision tenue, et un test la vérifie. Mais le nom
# distinctif de l'unité d'organisation porte le domaine et les noms d'unités
# RÉELS de l'établissement, ce qui n'a pas sa place dans un dépôt public.
# Ajouté le 19/09/2026 : le fichier venait d'apparaître, ni suivi ni ignoré,
# donc à un « git add . » près d'être publié.
parametres.json

# Annuaire d'adresses MAC lu par la console de parc : noms de machines et
# adresses MAC réelles. Le motif vaut à toute profondeur, donc aussi pour la
# copie écrite par le script de déploiement à côté de lui.
postes.csv

# Le script de déploiement, lui, est suivi depuis le 19/09/2026 : il vit dans
# scripts\ et le noyau l'embarque. L'exemple d'annuaire qui l'accompagne porte
# exprès un AUTRE nom — « postes.exemple.csv » — pour qu'il ne puisse jamais être
# confondu avec un vrai, et pour que la règle ci-dessus reste sans exception.

# LE DOSSIER DE TRAVAIL DU DÉPLOIEMENT, écrit par la console de parc dans
# Documents\FaultTracePC\Deploiement — c'est-à-dire ICI, puisque le dossier de
# données du logiciel et le dossier de développement sont le même. Il contient la
# liste des postes à vérifier (noms réels), les journaux de chaque exécution, et
# une copie du script extraite de la ressource embarquée.
#
# TROISIÈME FOIS EN DEUX JOURS qu'un dossier écrit par le logiciel apparaît à côté
# du code sans être nommé ici. La règle à retenir : tout chemin d'écriture ajouté
# au logiciel doit être ajouté à ce fichier DANS LE MÊME GESTE.
Deploiement/

# EN REVANCHE, CE QUE LE SCRIPT ÉCRIT NE L'EST PAS. Il range la transcription de
# chaque exécution dans un sous-dossier « Journal », à côté de lui : noms de
# postes, adresses IP, adresses MAC. Il est apparu dans scripts\ dès le premier
# essai du 19/09/2026 — le motif vaut à toute profondeur.
Journal/

# Dumps éventuellement copiés pour analyse
*.dmp

# Résidus de l'Explorateur Windows. « Thumbs.db » est un cache de VIGNETTES : il
# garde une image réduite de tout ce qui est passé dans le dossier, y compris
# des captures d'écran effacées depuis. Un exemplaire était suivi dans assets\
# jusqu'au 19/09/2026 — il ne contenait qu'une vignette du logo, mais il n'avait
# rien à faire là et rien ne l'aurait empêché d'en contenir d'autres.
Thumbs.db
ehthumbs.db
desktop.ini

# Corbeille locale : fichiers de test sortis du dossier de travail.
_to_delete/

# Dossier de travail des échanges avec Claude. Il contient le script de
# déploiement — distribué à part, pas dans ce dépôt — mais surtout postes.csv
# et Journal\, qui portent des noms de machines, des adresses MAC et des
# adresses IP réelles. Rien de tout cela n'a sa place dans un dépôt public, et
# un « git add . » les prenait jusqu'ici sans rien signaler.
Claude outputs/
