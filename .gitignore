bin/
obj/
*.user
.vs/
.idea/
publish/

# Artefacts de publication : exécutables, archive portable, MSI.
# Ils se reconstruisent avec build\publish.ps1 et installer\build-msi.ps1 —
# les versionner alourdirait le dépôt de centaines de Mo (GitHub refuse les
# fichiers > 100 Mo et alerte au-delà de 50 Mo). Pour les distribuer :
# passer par une Release GitHub.
dist/
*.msi
*.wixpdb
*.zip

# ---------------------------------------------------------------------------
# SORTIES DU LOGICIEL — À NE JAMAIS VERSIONNER
#
# FaultTracePC écrit ses rapports dans Documents\FaultTracePC, qui est aussi
# le dossier de développement : sans ces règles, des données personnelles de
# la machine analysée (matériel, processus, historique de pannes, journaux
# PowerShell) et surtout des SECRETS (tokens d'accès dans parc.json) se
# retrouvent dans le dépôt.
# ---------------------------------------------------------------------------
Diagnostic_*.html
Diagnostic_*.pdf
Parc_*.html
Reparation_PC_*.ps1
Reparation_PC_*.bat
Reparation_log_*.txt
# Journaux de compilation (build.log / test.log via Tee-Object).
# Note : .gitignore n'accepte PAS de commentaire en fin de ligne — le texte
# ferait partie du motif. Toujours sur une ligne dédiée.
*.log
rapport-*.html
inventaire_pilotes.txt
MajWindows_*.txt
maj.txt
# Préférence de langue, par utilisateur (Documents\FaultTracePC\langue.txt).
langue.txt

# Historique des scans (résumés machine) et configuration locale
Historique/
parc.json
remote.json
alerts.json
*.jsonl

# Dumps éventuellement copiés pour analyse
*.dmp

# Corbeille locale : fichiers de test sortis du dossier de travail.
_to_delete/

# Dossier de travail des échanges avec Claude. Il contient le script de
# déploiement — distribué à part, pas dans ce dépôt — mais surtout postes.csv
# et Journal\, qui portent des noms de machines, des adresses MAC et des
# adresses IP réelles. Rien de tout cela n'a sa place dans un dépôt public, et
# un « git add . » les prenait jusqu'ici sans rien signaler.
Claude outputs/
