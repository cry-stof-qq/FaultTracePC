<?xml version="1.0" encoding="utf-8"?>
<!--
    FaultTracePC — paquet d'installation MSI (déployable par GPO)

    Installe dans %ProgramFiles%\FaultTracePC :
      · FaultTracePC.exe          application (interface graphique)
      · FaultTracePC.Cli.exe      diagnostic en ligne de commande
      · FaultTracePC.Monitor.exe  service de surveillance « boîte noire »

    Le service est enregistré et démarré par l'installeur, arrêté et supprimé à
    la désinstallation. Installation par machine (perMachine) : déployable en
    « Attribué à l'ordinateur » dans une stratégie de groupe.

    Construction : installer\build-msi.ps1   (voir ce script pour les prérequis)
    La version du paquet est fournie par le script (-d Version=…) : incrémente-la
    à chaque livraison, sinon la mise à niveau automatique ne se déclenche pas.

    NOTE : l'élément <Files> (récolte automatique d'un dossier) n'existe qu'à
    partir de WiX v5 — d'où la version épinglée dans le script de construction.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="FaultTracePC"
           Manufacturer="Cry-stof"
           Version="$(Version).0"
           UpgradeCode="93D2A8BD-E05A-4FB6-91C8-FC13D88871D5"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="FaultTracePC — diagnostic des pannes Windows 10/11"
                        Manufacturer="Cry-stof" />

    <!-- Une nouvelle version remplace proprement l'ancienne. -->
    <!-- AllowSameVersionUpgrades : sans cette option, WiX ne reconnaît comme mise à
         jour qu'une version STRICTEMENT inférieure. Le ProductCode étant régénéré à
         chaque compilation, réinstaller le même numéro par-dessus lui-même était
         refusé par l'erreur 1638 — « une autre version de ce produit est déjà
         installée ». Constaté le 30/08/2026 en préparant un déploiement : avec
         « /qn », l'échec est de surcroît totalement silencieux.
         Un déploiement n'est jamais linéaire — poste repris, script relancé — donc
         le paquet doit savoir se remplacer lui-même. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Une version plus récente de FaultTracePC est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Icône du produit (Applications installées, raccourci).
         Le chemin passe par une variable : WiX résout SourceFile par rapport au
         répertoire courant, pas au fichier .wxs — un chemin relatif casserait
         selon l'endroit d'où le script est lancé. -->
    <Icon Id="AppIcon.ico" SourceFile="$(AssetsDir)\FaultTracePC.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- ================= Interface d'installation =================
         WixUI_FeatureTree affiche la liste des composants avec des cases à
         cocher : le raccourci du Bureau y figure, coché par défaut, et peut
         être décoché. La case « Lancer maintenant » est celle, standard, de
         l'écran final.

         Les deux restent pilotables en installation silencieuse (GPO) :
             msiexec /i FaultTracePC.msi /qn ADDLOCAL=Main,DesktopShortcutFeature
             msiexec /i FaultTracePC.msi /qn ADDLOCAL=Main          (sans raccourci Bureau)
         En mode /qn l'écran final n'existe pas : rien n'est lancé, ce qui est
         le comportement attendu d'un déploiement automatisé. -->
    <UI>
      <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLFOLDER" />

      <!-- Publish DOIT être enfant de <UI> : placé directement sous <Package>,
           WiX répond « WIX0005: unexpected child element 'Publish' ». -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Lancer FaultTracePC maintenant" />

    <!-- Lancement de l'application depuis l'écran final.
         Action de type 50 (exécutable désigné par une propriété) : elle évite
         d'ajouter l'extension Util juste pour un ShellExec. Impersonate="yes"
         est important — sans cela l'application démarrerait avec le compte
         SYSTEM du programme d'installation, pas avec celui de l'utilisateur.
         Return="asyncNoWait" : l'installeur se ferme sans attendre. -->
    <!-- ============ Lancement à la fin de l'installation ============

         Deux approches ont échoué avant celle-ci, toutes deux SILENCIEUSEMENT :

         1. deux actions homonymes — <SetProperty Id="X"> crée aussi une action
            nommée X, qui écrasait celle censée lancer l'exécutable ;
         2. un chemin bâti sur [#FaultTracePC.exe], c'est-à-dire sur l'identifiant
            de fichier engendré par la collecte automatique <Files Include="**"> :
            cet identifiant n'est pas garanti d'être « FaultTracePC.exe », et une
            référence non résolue produit une chaîne VIDE, donc une action qui ne
            lance rien sans lever la moindre erreur.

         D'où ce choix, volontairement fruste : on exécute cmd.exe — dont le
         chemin est donné par une propriété standard de Windows Installer — avec
         « start », et on construit le chemin cible à partir du dossier
         d'installation. Plus aucun identifiant interne dans l'équation.

         « start » rend la main aussitôt, donc l'installeur ne reste pas suspendu.
         Impersonate="yes" est indispensable : sans lui, l'application démarrerait
         sous le compte SYSTEM du programme d'installation au lieu de celui de
         l'utilisateur. Le premier guillemet vide après « start » est le titre de
         fenêtre — l'omettre ferait prendre le chemin entre guillemets pour un
         titre, et rien ne se lancerait. -->
    <!-- ============ Langue imposée au poste (déploiement) ============

         msiexec /i FaultTracePC-1.3.0.msi FTPCLANG=en /qn

         Écrit C:\ProgramData\FaultTracePC\langue.txt, la préférence de portée
         MACHINE. Elle s'intercale entre la session Windows et le choix propre à
         chaque utilisateur : elle impose un DÉFAUT au poste, elle ne contredit
         pas quelqu'un qui a cliqué sur le sélecteur de l'application.

         L'écriture est déléguée à FaultTracePC.Cli.exe plutôt que scriptée en
         MSI : la CLI connaît déjà le chemin, valide déjà le code de langue, et
         la même commande sert à rattraper un poste à la main.

         Execute="deferred" + Impersonate="no" : l'action tourne avec le compte
         SYSTEM du programme d'installation. Indispensable sous GPO « Attribué à
         l'ordinateur », où il n'y a aucun utilisateur interactif.

         After="InstallFiles" : l'exécutable doit exister quand on l'appelle.

         Return="ignore" : une langue par défaut qui ne se pose pas ne doit
         JAMAIS faire échouer une installation. En contrepartie l'échec est
         silencieux — vérification après coup :
             Get-Content C:\ProgramData\FaultTracePC\langue.txt
         Sans FTPCLANG, la condition est fausse et rien ne s'exécute : le
         comportement par défaut reste « suivre la session Windows ».

         Secure="yes" : sans cela, une propriété publique passée en ligne de
         commande n'atteint pas la partie élevée de l'installation. -->
    <Property Id="FTPCLANG" Secure="yes" />

    <!-- Action de type « exécutable désigné par une propriété » : aucune
         extension WiX supplémentaire n'est nécessaire. Le script de construction
         n'installe que WixToolset.UI.wixext ; toute référence à l'extension Util
         (CAQuietExec, Wix4UtilCA_X64) échouerait à la compilation.

         TROISIÈME ÉCHEC SILENCIEUX DE CE FICHIER, corrigé ici. Une première
         version mettait le chemin ET les arguments dans la propriété, en
         laissant ExeCommand vide. Le journal verbeux dit alors :

             emplacement: «guillemet»C:\…\FaultTracePC.Cli.exe«guillemet» suivi
             des arguments, commande: (vide) ... puis Note: 1: 1721

         Windows Installer passe l'emplacement à CreateProcess comme NOM
         D'APPLICATION, pas comme ligne de commande. Un « chemin » qui contient
         des arguments et des guillemets ne désigne aucun fichier : erreur 1721.

         Le partage correct est donc : la propriété ne porte QUE le chemin, sans
         guillemets (un nom d'application n'est pas analysé, les espaces de
         « Program Files » ne posent aucun problème), et ExeCommand porte les
         arguments.

         Mais ExeCommand est une donnée STATIQUE du paquet : une action différée
         ne sait pas résoudre [FTPCLANG] au moment de l'exécution. D'où trois
         actions à arguments figés, départagées par condition. « auto » est
         proposé pour qu'une mise à niveau puisse EFFACER un réglage posé
         auparavant, au lieu d'être obligée de le laisser en place. -->

    <SetProperty Id="SetMachineLanguageFr" Value="[INSTALLFOLDER]FaultTracePC.Cli.exe"
                 Sequence="execute" Before="SetMachineLanguageFr" />
    <CustomAction Id="SetMachineLanguageFr" Property="SetMachineLanguageFr"
                  ExeCommand="--set-machine-lang fr"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="SetMachineLanguageEn" Value="[INSTALLFOLDER]FaultTracePC.Cli.exe"
                 Sequence="execute" Before="SetMachineLanguageEn" />
    <CustomAction Id="SetMachineLanguageEn" Property="SetMachineLanguageEn"
                  ExeCommand="--set-machine-lang en"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="SetMachineLanguageAuto" Value="[INSTALLFOLDER]FaultTracePC.Cli.exe"
                 Sequence="execute" Before="SetMachineLanguageAuto" />
    <CustomAction Id="SetMachineLanguageAuto" Property="SetMachineLanguageAuto"
                  ExeCommand="--set-machine-lang auto"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- « ~= » compare sans tenir compte de la casse : FTPCLANG=EN doit marcher
         aussi bien que FTPCLANG=en. -->
    <InstallExecuteSequence>
      <Custom Action="SetMachineLanguageFr" After="InstallFiles" Condition="FTPCLANG ~= &quot;fr&quot;" />
      <Custom Action="SetMachineLanguageEn" After="InstallFiles" Condition="FTPCLANG ~= &quot;en&quot;" />
      <Custom Action="SetMachineLanguageAuto" After="InstallFiles" Condition="FTPCLANG ~= &quot;auto&quot;" />
    </InstallExecuteSequence>

    <SetProperty Id="LaunchShell" Value="[System64Folder]cmd.exe" Sequence="ui" After="CostFinalize" />
    <CustomAction Id="LaunchApplication" Property="LaunchShell"
                  ExeCommand="/c start &quot;&quot; &quot;[INSTALLFOLDER]FaultTracePC.exe&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FaultTracePC" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="FaultTracePC" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="FaultTracePC" Level="1" AllowAbsent="no"
             Description="Application, outil en ligne de commande et service de surveillance.">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="MonitorService" />
      <ComponentRef Id="AppShortcuts" />
    </Feature>

    <!-- Fonctionnalité séparée = case à cocher dans l'arbre, cochée par défaut
         (Level="1"). L'utilisateur peut la décocher ; un déploiement GPO peut
         l'omettre via ADDLOCAL. -->
    <Feature Id="DesktopShortcutFeature" Title="Raccourci sur le Bureau" Level="1"
             Description="Place une icône FaultTracePC sur le Bureau.">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- ===================== Fichiers publiés ===================== -->
    <!-- Tout le dossier de publication SAUF l'exe du service, déclaré à part
         ci-dessous car il porte l'enregistrement du service Windows. -->
    <ComponentGroup Id="ProductFiles" Directory="INSTALLFOLDER">
      <Files Include="$(SourceDir)\**">
        <!-- L'exclusion est un ÉLÉMENT enfant (attribut Files), pas un attribut
             de <Files> : c'est la syntaxe attendue par WiX v5/v6. -->
        <Exclude Files="$(SourceDir)\FaultTracePC.Monitor.exe" />
      </Files>
    </ComponentGroup>

    <!-- ===================== Service de surveillance ===================== -->
    <Component Id="MonitorService" Directory="INSTALLFOLDER"
               Guid="0BDCA604-E6A6-4D0F-8B3A-CE7E3075D5EE">
      <File Id="MonitorExe" Source="$(SourceDir)\FaultTracePC.Monitor.exe" KeyPath="yes" />

      <ServiceInstall Id="MonitorServiceInstall"
                      Name="FaultTracePCMonitor"
                      DisplayName="FaultTracePC — Surveillance temps réel"
                      Description="Boîte noire FaultTracePC : journal continu (températures, mémoire, événements) pour retrouver les secondes précédant un crash."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes" />

      <ServiceControl Id="MonitorServiceControl"
                      Name="FaultTracePCMonitor"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- ===================== Raccourcis ===================== -->
    <Component Id="AppShortcuts" Directory="AppShortcutFolder"
               Guid="EFC30DB5-AEE4-4164-A091-B40482F5D784">
      <Shortcut Id="AppShortcut"
                Name="FaultTracePC"
                Description="Diagnostic des pannes Windows"
                Target="[INSTALLFOLDER]FaultTracePC.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Cry-stof\FaultTracePC"
                     Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder"
               Guid="7C4B9E22-1F3A-4D58-9A6E-2B8C51D0F4A7">
      <Shortcut Id="AppDesktopShortcut"
                Name="FaultTracePC"
                Description="Diagnostic des pannes Windows"
                Target="[INSTALLFOLDER]FaultTracePC.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\Cry-stof\FaultTracePC"
                     Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
