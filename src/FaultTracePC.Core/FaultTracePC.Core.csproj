<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Permet la compilation croisée depuis un environnement non-Windows (CI/cloud). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyTitle>FaultTracePC Core</AssemblyTitle>
    <Description>Moteur de collecte et de diagnostic de pannes Windows (FaultTracePC)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le projet de tests accède aux helpers internes (parsing de dumps, formatage). -->
    <InternalsVisibleTo Include="FaultTracePC.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- LE SCRIPT DE DÉPLOIEMENT VOYAGE AVEC LE LOGICIEL (point 64, lot B).
         Décidé le 19/09/2026 : distribué à part, il existait en deux exemplaires
         qui ont fini par diverger. Et le contrat JSON du lot B lie le script à la
         console — deux fichiers livrés séparément se désynchronisent sans que rien
         ne le signale, le symptôme étant un journal illisible.
         LogicalName est fixé explicitement : sans lui, le nom de la ressource se
         déduirait du chemin du fichier, et déplacer le dossier casserait la
         lecture en silence. ScriptEmbarqueTests le vérifie à chaque compilation. -->
    <EmbeddedResource Include="..\..\scripts\Deployer-FaultTracePC.ps1"
                      LogicalName="FaultTracePC.Deployer-FaultTracePC.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accès WMI (Win32_OperatingSystem, Win32_DiskDrive, etc.) -->
    <PackageReference Include="System.Management" Version="10.0.10" />
    <!-- Lecture du journal d'événements Windows (EventLogQuery / EventLogReader) -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.10" />
    <!-- Interrogation LDAP de l'Active Directory (DirectorySearcher).
         Volontairement PAS le module PowerShell ActiveDirectory : il exigerait RSAT
         sur chaque poste d'administration. Ici, un poste du domaine suffit. -->
    <PackageReference Include="System.DirectoryServices" Version="10.0.10" />
  </ItemGroup>

</Project>
