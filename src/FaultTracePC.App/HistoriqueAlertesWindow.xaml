<Window x:Class="FaultTracePC.App.HistoriqueAlertesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FaultTracePC.App"
        Title="{x:Static loc:L.HistoTitle}"
        Icon="Assets/FaultTracePC.ico"
        Width="1000" Height="600" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
        Loaded="Fenetre_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#182848" Padding="16,10">
            <TextBlock x:Name="TxtEntete" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="1" Padding="14,10" Background="#EDF1F6">
            <StackPanel>
                <!-- CE QUE CETTE FENÊTRE EST, ÉCRIT EN HAUT. Sans cette phrase, un
                     tableau vide se lit « ce poste va bien » alors qu'il peut vouloir
                     dire « la console ne l'a jamais interrogé ». -->
                <TextBlock Text="{x:Static loc:L.HistoIntro}" TextWrapping="Wrap"
                           FontSize="12.5" Foreground="#44546A" Margin="0,0,0,10"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:L.HistoPeriod}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CbPeriode" Width="190" VerticalAlignment="Center"
                              SelectionChanged="CbPeriode_SelectionChanged"/>
                    <Button x:Name="BtnOuvrirDossier" Content="{x:Static loc:L.HistoOpenFolder}"
                            Padding="12,5" Margin="10,0,0,0" Click="BtnOuvrirDossier_Click"
                            ToolTip="{x:Static loc:L.HistoOpenFolderTip}"/>
                    <TextBlock x:Name="TxtCompte" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" Foreground="#44546A"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ListView x:Name="LvAlertes" Grid.Row="2" Margin="10" BorderThickness="1"
                  BorderBrush="#DBE2EC" FontSize="12">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="ToolTip" Value="{Binding Complet}"/>
                    <Style.Triggers>
                        <!-- Les critiques sautent aux yeux : « agir maintenant » et
                             « à surveiller » ne se lisent pas de la même façon. -->
                        <DataTrigger Binding="{Binding Critique}" Value="True">
                            <Setter Property="Background" Value="#FBE3E3"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static loc:L.HistoColDate}" Width="135" DisplayMemberBinding="{Binding Quand}"/>
                    <GridViewColumn Header="{x:Static loc:L.HistoColLevel}" Width="90" DisplayMemberBinding="{Binding Niveau}"/>
                    <GridViewColumn Header="{x:Static loc:L.HistoColTitle}" Width="320" DisplayMemberBinding="{Binding Titre}"/>
                    <GridViewColumn Header="{x:Static loc:L.HistoColDetail}" Width="400" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Background="#EDF1F6" Padding="14,8">
            <TextBlock x:Name="TxtStatut" FontSize="12" Foreground="#44546A"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
        </Border>
    </Grid>
</Window>
