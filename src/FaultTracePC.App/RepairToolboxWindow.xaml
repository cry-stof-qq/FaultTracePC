<Window x:Class="FaultTracePC.App.RepairToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FaultTracePC.App"
        Title="{x:Static loc:L.ToolTitle}"
        Icon="Assets/FaultTracePC.ico"
        Width="820" Height="640" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#182848" Padding="16,10">
            <TextBlock Foreground="White" FontSize="15" FontWeight="SemiBold"
                       Text="{x:Static loc:L.ToolHeader}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,8">
            <StackPanel>

                <!-- ============ Filet de sécurité ============ -->
                <GroupBox Header="{x:Static loc:L.ToolGrpBefore}" FontSize="13" Padding="8" Margin="0,4">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#44546A" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{x:Static loc:L.ToolBeforeText}"/>
                        <WrapPanel>
                            <Button Content="{x:Static loc:L.ToolRestorePoint}" Padding="10,6" Margin="0,0,8,4"
                                    FontWeight="SemiBold" Background="#2470B3" Foreground="White" BorderThickness="0"
                                    Click="BtnRestorePoint_Click"
                                    ToolTip="{x:Static loc:L.ToolRestorePointTip}"/>
                            <Button Content="{x:Static loc:L.ToolOpenRestore}" Padding="10,6" Margin="0,0,8,4"
                                    Tag="rstrui" Click="BtnTool_Click"
                                    ToolTip="{x:Static loc:L.ToolOpenRestoreTip}"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ============ Nettoyage (celui qui libère vraiment de la place) ============ -->
                <GroupBox Header="{x:Static loc:L.ToolGrpSpace}" FontSize="13" Padding="8" Margin="0,8,0,4">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#44546A" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{x:Static loc:L.ToolSpaceText}"/>
                        <WrapPanel>
                            <Button Content="{x:Static loc:L.ToolWhereSpace}" Padding="10,6" Margin="0,0,8,6" Tag="diskusage" Click="BtnTool_Click"
                                    ToolTip="{x:Static loc:L.ToolWhereSpaceTip}"/>
                            <Button Content="{x:Static loc:L.ToolCleanComponents}" Padding="10,6" Margin="0,0,8,6" Tag="componentcleanup" Click="BtnTool_Click"
                                    ToolTip="{x:Static loc:L.ToolCleanComponentsTip}"/>
                            <Button Content="{x:Static loc:L.ToolCleanTemp}" Padding="10,6" Margin="0,0,8,6" Tag="temp" Click="BtnTool_Click"
                                    ToolTip="{x:Static loc:L.ToolCleanTempTip}"/>
                            <Button Content="{x:Static loc:L.ToolDiskCleanup}" Padding="10,6" Margin="0,0,8,6" Tag="cleanmgr" Click="BtnTool_Click"
                                    ToolTip="{x:Static loc:L.ToolDiskCleanupTip}"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ============ Démarrage, sécurité, réseau ============ -->
                <GroupBox Header="{x:Static loc:L.ToolGrpStartup}" FontSize="13" Padding="8" Margin="0,4">
                    <WrapPanel>
                        <Button Content="{x:Static loc:L.ToolStartupApps}" Padding="10,6" Margin="0,0,8,6" Tag="startup" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolStartupAppsTip}"/>
                        <Button Content="{x:Static loc:L.ToolQuickScan}" Padding="10,6" Margin="0,0,8,6" Tag="defenderquick" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolQuickScanTip}"/>
                        <Button Content="{x:Static loc:L.ToolFullScan}" Padding="10,6" Margin="0,0,8,6" Tag="defenderfull" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolFullScanTip}"/>
                        <Button Content="{x:Static loc:L.ToolThreats}" Padding="10,6" Margin="0,0,8,6" Tag="defenderhistory" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolThreatsTip}"/>
                        <Button Content="{x:Static loc:L.ToolNetReset}" Padding="10,6" Margin="0,0,8,6" Tag="networkreset" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolNetResetTip}"/>
                        <Button Content="{x:Static loc:L.ToolBatteryReport}" Padding="10,6" Margin="0,0,8,6" Tag="battery" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolBatteryReportTip}"/>
                        <Button Content="{x:Static loc:L.ToolResMon}" Padding="10,6" Margin="0,0,8,6" Tag="resmon" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolResMonTip}"/>
                    </WrapPanel>
                </GroupBox>

                <!-- ============ Windows Update ============ -->
                <GroupBox Header="{x:Static loc:L.ToolGrpUpdate}" FontSize="13" Padding="8" Margin="0,4">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#44546A" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{x:Static loc:L.ToolUpdateText}"/>
                        <ListView x:Name="LvUpdates" Height="150" BorderBrush="#DBE2EC" BorderThickness="1" FontSize="12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="KB" Width="110" DisplayMemberBinding="{Binding Kb}"/>
                                    <GridViewColumn Header="{x:Static loc:L.ToolColType}" Width="180" DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="{x:Static loc:L.ToolColInstalled}" Width="110" DisplayMemberBinding="{Binding InstalledOn}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{x:Static loc:L.ToolRefresh}" Padding="10,6" Margin="0,0,8,4" Click="BtnLoadUpdates_Click"/>
                            <Button Content="{x:Static loc:L.ToolUninstallUpdate}" Padding="10,6" Margin="0,0,8,4"
                                    FontWeight="SemiBold" Click="BtnUninstallUpdate_Click"
                                    ToolTip="{x:Static loc:L.ToolUninstallUpdateTip}"/>
                            <Button Content="{x:Static loc:L.ToolResetWu}" Padding="10,6" Margin="0,0,8,4"
                                    Tag="wureset" Click="BtnTool_Click"
                                    ToolTip="{x:Static loc:L.ToolResetWuTip}"/>
                            <Button Content="{x:Static loc:L.ToolInPlace}" Padding="10,6" Margin="0,0,8,4"
                                    Click="BtnInPlaceRepair_Click"
                                    ToolTip="{x:Static loc:L.ToolInPlaceTip}"/>
                            <Button Content="{x:Static loc:L.ToolFindUpdates}"
                                    Padding="10,6" Margin="0,0,8,4" FontWeight="SemiBold"
                                    Click="BtnWindowsUpdate_Click"
                                    ToolTip="{x:Static loc:L.ToolFindUpdatesTip}"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ============ Réparations système ============ -->
                <GroupBox Header="{x:Static loc:L.ToolGrpRepair}" FontSize="13" Padding="8" Margin="0,8,0,4">
                    <WrapPanel>
                        <Button Content="{x:Static loc:L.ToolSfc}" Padding="10,6" Margin="0,0,8,6" Tag="sfc" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolSfcTip}"/>
                        <Button Content="{x:Static loc:L.ToolDismScan}" Padding="10,6" Margin="0,0,8,6" Tag="dismscan" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolDismScanTip}"/>
                        <Button Content="{x:Static loc:L.ToolDismRestore}" Padding="10,6" Margin="0,0,8,6" Tag="dismrestore" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolDismRestoreTip}"/>
                        <Button Content="{x:Static loc:L.ToolCheckDisk}" Padding="10,6" Margin="0,0,8,6" Tag="chkdskscan" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolCheckDiskTip}"/>
                        <Button Content="{x:Static loc:L.ToolChkdsk}" Padding="10,6" Margin="0,0,8,6" Tag="chkdskfix" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolChkdskTip}"/>
                        <Button Content="{x:Static loc:L.ToolMemDiag}" Padding="10,6" Margin="0,0,8,6" Tag="mdsched" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolMemDiagTip}"/>
                        <Button Content="{x:Static loc:L.ToolEnergy}" Padding="10,6" Margin="0,0,8,6" Tag="energy" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolEnergyTip}"/>
                        <Button Content="{x:Static loc:L.ToolSmart}" Padding="10,6" Margin="0,0,8,6" Tag="smart" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolSmartTip}"/>
                        <Button Content="{x:Static loc:L.ToolWinDbg}" Padding="10,6" Margin="0,0,8,6" Tag="windbg" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolWinDbgTip}"/>
                        <Button Content="{x:Static loc:L.ToolLinkPower}" Padding="10,6" Margin="0,0,8,6" Tag="linkpower" Click="BtnTool_Click"
                                ToolTip="{x:Static loc:L.ToolLinkPowerTip}"/>
                    </WrapPanel>
                </GroupBox>

                <!-- ============ Consoles Windows ============ -->
                <GroupBox Header="{x:Static loc:L.ToolGrpConsoles}" FontSize="13" Padding="8" Margin="0,4">
                    <WrapPanel>
                        <Button Content="{x:Static loc:L.ToolReliability}" Padding="10,6" Margin="0,0,8,6" Tag="reliability" Click="BtnTool_Click"/>
                        <Button Content="{x:Static loc:L.ToolEventViewer}" Padding="10,6" Margin="0,0,8,6" Tag="eventvwr" Click="BtnTool_Click"/>
                        <Button Content="{x:Static loc:L.ToolWuSettings}" Padding="10,6" Margin="0,0,8,6" Tag="wusettings" Click="BtnTool_Click"/>
                        <Button Content="{x:Static loc:L.ToolDiskMgmt}" Padding="10,6" Margin="0,0,8,6" Tag="diskmgmt" Click="BtnTool_Click"/>
                        <Button Content="{x:Static loc:L.ToolSysInfo}" Padding="10,6" Margin="0,0,8,6" Tag="msinfo" Click="BtnTool_Click"/>
                    </WrapPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#EDF1F6" Padding="14,8">
            <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="#44546A"
                       Text="{x:Static loc:L.ToolFooter}"/>
        </Border>
    </Grid>
</Window>
