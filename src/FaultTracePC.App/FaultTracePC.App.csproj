<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms uniquement pour NotifyIcon (icône de zone de notification). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Permet la compilation croisée depuis un environnement non-Windows (CI/cloud). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>FaultTracePC</AssemblyName>
    <RootNamespace>FaultTracePC.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.7.0</Version>
    <Product>FaultTracePC</Product>
    <Company>Cry-stof</Company>
    <Description>Diagnostic des pannes et crashs Windows 10/11</Description>

    <!-- Publication : exe unique. Voir README pour framework-dependent vs self-contained. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms n'est activé que pour NotifyIcon : on retire ses usings implicites,
         sinon System.Windows.Forms.Application / System.Drawing.Brush entrent en
         collision avec leurs homonymes WPF (CS0104). Le code WinForms de ce projet
         est écrit en noms complets (System.Windows.Forms.NotifyIcon, etc.). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaultTracePC.Core\FaultTracePC.Core.csproj" />
  </ItemGroup>

</Project>
