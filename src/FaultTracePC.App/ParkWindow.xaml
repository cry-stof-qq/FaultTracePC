<Window x:Class="FaultTracePC.App.ParkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaultTracePC — Console Parc"
        Width="960" Height="560" MinWidth="780" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#182848" Padding="16,10">
            <TextBlock Text="🖥 Console Parc — état des machines clientes" Foreground="White"
                       FontSize="15" FontWeight="SemiBold"/>
        </Border>

        <!-- Ajout d'une machine -->
        <Border Grid.Row="1" Padding="14,10" Background="#EDF1F6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Nom :" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="TxtName" Width="120" VerticalAlignment="Center"/>
                <TextBlock Text="Hôte/IP :" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="TxtHost" Width="140" VerticalAlignment="Center"/>
                <TextBlock Text="Port :" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="TxtPort" Width="60" Text="58620" VerticalAlignment="Center"/>
                <TextBlock Text="Token :" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="TxtToken" Width="200" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                <Button Content="➕ Ajouter" Padding="12,5" Margin="12,0,0,0" Click="BtnAdd_Click"/>
                <Button Content="🗑 Retirer la sélection" Padding="12,5" Margin="8,0,0,0" Click="BtnRemove_Click"/>
                <Button Content="🔄 Actualiser tout" Padding="12,5" Margin="8,0,0,0" FontWeight="SemiBold" Click="BtnRefresh_Click"/>
            </WrapPanel>
        </Border>

        <ListView x:Name="LvMachines" Grid.Row="2" Margin="10" BorderThickness="1" BorderBrush="#DBE2EC" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Machine" Width="130" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Hôte" Width="130" DisplayMemberBinding="{Binding Host}"/>
                    <GridViewColumn Header="État" Width="150" DisplayMemberBinding="{Binding Etat}"/>
                    <GridViewColumn Header="Dernier relevé" Width="120" DisplayMemberBinding="{Binding DernierReleve}"/>
                    <GridViewColumn Header="CPU %" Width="60" DisplayMemberBinding="{Binding Cpu}"/>
                    <GridViewColumn Header="T° CPU" Width="65" DisplayMemberBinding="{Binding TempCpu}"/>
                    <GridViewColumn Header="T° GPU" Width="65" DisplayMemberBinding="{Binding TempGpu}"/>
                    <GridViewColumn Header="RAM %" Width="60" DisplayMemberBinding="{Binding Ram}"/>
                    <GridViewColumn Header="Top processus" Width="230" DisplayMemberBinding="{Binding Top}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Background="#EDF1F6" Padding="14,8">
            <Grid>
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontSize="12" Foreground="#44546A"
                           Text="Ajoute tes machines clientes (mode Client activé sur chacune via 🌐), puis Actualiser."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRemoteScan" Content="🩺 Lancer un diagnostic à distance" Padding="12,6"
                            FontSize="12" Margin="0,0,8,0" FontWeight="SemiBold"
                            Background="#2470B3" Foreground="White" BorderThickness="0"
                            Click="BtnRemoteScan_Click"
                            ToolTip="Déclenche un scan complet sur la machine sélectionnée puis ouvre son rapport HTML. Peut prendre plusieurs minutes (analyse des dumps comprise)."/>
                    <Button Content="📄 Ouvrir le dernier rapport" Padding="12,6" FontSize="12" Click="BtnOpenReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
