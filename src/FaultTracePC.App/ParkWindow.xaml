<Window x:Class="FaultTracePC.App.ParkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FaultTracePC.App"
        Title="{x:Static loc:L.ParkTitle}"
        Icon="Assets/FaultTracePC.ico"
        Width="1180" Height="640" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
        Loaded="ParkWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#182848" Padding="16,10">
            <TextBlock Text="{x:Static loc:L.ParkHeader}" Foreground="White"
                       FontSize="15" FontWeight="SemiBold"/>
        </Border>

        <TabControl Grid.Row="1" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">

            <!-- ============================================================
                 SUPERVISION — les machines déjà suivies, interrogées en direct.
                 Contenu inchangé : seuls les numéros de ligne ont bougé, la
                 grille de la fenêtre étant devenue celle de l'onglet.
                 ============================================================ -->
            <TabItem Header="{x:Static loc:L.ParkTabMonitoring}" Padding="14,6">
              <Grid Background="#F4F6F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Secret maître + ajout d'une machine -->
                <Border Grid.Row="0" Padding="14,10" Background="#EDF1F6">
                  <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static loc:L.ParkSecretLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <PasswordBox x:Name="PwdSecret" Width="260" VerticalAlignment="Center"
                                     FontFamily="Consolas" FontSize="11"
                                     ToolTip="{x:Static loc:L.ParkSecretTip}"/>
                        <Button Content="{x:Static loc:L.ParkSecretSave}" Padding="12,5" Margin="8,0,0,0" Click="BtnSecretSave_Click"/>
                        <Button Content="{x:Static loc:L.ParkSecretForget}" Padding="12,5" Margin="8,0,0,0" Click="BtnSecretForget_Click"/>
                        <TextBlock x:Name="TxtSecretEtat" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="12" Foreground="#44546A"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static loc:L.ParkName}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtName" Width="120" VerticalAlignment="Center"
                                 ToolTip="{x:Static loc:L.ParkNameTip}"/>
                        <TextBlock Text="{x:Static loc:L.ParkHost}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtHost" Width="140" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:L.ParkPort}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtPort" Width="60" Text="58620" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:L.ParkToken}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtToken" Width="200" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkTokenTip}"/>
                        <Button Content="{x:Static loc:L.ParkAdd}" Padding="12,5" Margin="12,0,0,0" Click="BtnAdd_Click"/>
                        <Button Content="{x:Static loc:L.ParkRemove}" Padding="12,5" Margin="8,0,0,0" Click="BtnRemove_Click"/>
                        <Button Content="{x:Static loc:L.ParkRefreshAll}" Padding="12,5" Margin="8,0,0,0" FontWeight="SemiBold" Click="BtnRefresh_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <ListView x:Name="LvMachines" Grid.Row="1" Margin="0,10" BorderThickness="1" BorderBrush="#DBE2EC" FontSize="12">
                    <!-- LE SURVOL DIT CE QUE LA COLONNE NE PEUT PAS DIRE. « État » fait
                         150 pixels ; un refus a quatre causes possibles, et les nommer
                         demande un paragraphe. Le tronquer reviendrait a ne rien dire. -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Aide}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Aide}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <!-- LES LARGEURS ONT ÉTÉ RESSERRÉES pour loger « Alertes 90 j »
                                 sans pousser une colonne hors de la fenêtre : le total des
                                 colonnes doit rester sous la largeur utile (1 180 px moins
                                 la bordure et l'ascenseur). C'est l'erreur qui avait déjà
                                 caché la colonne « Vérification » dans l'onglet Inventaire. -->
                            <GridViewColumn Header="{x:Static loc:L.ParkColMachine}" Width="130" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColHost}" Width="120" DisplayMemberBinding="{Binding Host}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColState}" Width="150" DisplayMemberBinding="{Binding Etat}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColVersion}" Width="150" DisplayMemberBinding="{Binding Version}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColLast}" Width="115" DisplayMemberBinding="{Binding DernierReleve}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColCpu}" Width="55" DisplayMemberBinding="{Binding Cpu}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColCpuTemp}" Width="60" DisplayMemberBinding="{Binding TempCpu}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColGpuTemp}" Width="60" DisplayMemberBinding="{Binding TempGpu}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColRam}" Width="55" DisplayMemberBinding="{Binding Ram}"/>
                            <!-- POINT 43 — le décompte qui permet de dire « celui-là alerte
                                 trois fois plus que les autres ». L'en-tête porte une bulle
                                 d'aide parce qu'un nombre sans sa période ne veut rien dire. -->
                            <GridViewColumn Width="95" DisplayMemberBinding="{Binding Alertes90}">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{x:Static loc:L.ParkColAlertes90}"
                                               ToolTip="{x:Static loc:L.ParkColAlertes90Tip}"/>
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static loc:L.ParkColTop}" Width="160" DisplayMemberBinding="{Binding Top}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Grid.Row="2" Background="#EDF1F6" Padding="14,8">
                    <!-- DEUX COLONNES, ET PAS DEUX ÉLÉMENTS SUPERPOSÉS. Avec un
                         cinquième bouton, une barre d'état un peu longue passerait
                         SOUS les boutons et deviendrait illisible sans qu'on
                         comprenne pourquoi. La colonne * laisse au texte la place
                         qui reste, et le reste est tronqué proprement. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- La bulle d'aide reprend le texte de la barre elle-même : la
                             colonne s'est rétrécie en accueillant un bouton de plus, et un
                             message tronqué doit rester lisible au survol. -->
                        <TextBlock x:Name="TxtStatus" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#44546A"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,0,10,0"
                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                   Text="{x:Static loc:L.ParkHint}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnParkReport" Content="{x:Static loc:L.ParkReport}" Padding="12,6"
                                    FontSize="12" Margin="0,0,8,0" Click="BtnParkReport_Click"
                                    ToolTip="{x:Static loc:L.ParkReportTip}"/>
                            <Button x:Name="BtnBoiteNoire" Content="{x:Static loc:L.FlightOpen}"
                                    Padding="12,6" FontSize="12" Margin="0,0,8,0"
                                    Click="BtnBoiteNoire_Click"
                                    ToolTip="{x:Static loc:L.FlightOpenTip}"/>
                            <Button x:Name="BtnHistoriqueAlertes" Content="{x:Static loc:L.ParkHistoAlertes}"
                                    Padding="12,6" FontSize="12" Margin="0,0,8,0"
                                    Click="BtnHistoriqueAlertes_Click"
                                    ToolTip="{x:Static loc:L.ParkHistoAlertesTip}"/>
                            <Button x:Name="BtnRemoteScan" Content="{x:Static loc:L.ParkRemoteScan}" Padding="12,6"
                                    FontSize="12" Margin="0,0,8,0" FontWeight="SemiBold"
                                    Background="#2470B3" Foreground="White" BorderThickness="0"
                                    Click="BtnRemoteScan_Click"
                                    ToolTip="{x:Static loc:L.ParkRemoteScanTip}"/>
                            <Button Content="{x:Static loc:L.ParkOpenReport}" Padding="12,6" FontSize="12" Click="BtnOpenReport_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
              </Grid>
            </TabItem>

            <!-- ============================================================
                 INVENTAIRE — point 64, lot A-3.
                 AUCUNE MACHINE N'EST CONTACTÉE ICI. Cet onglet lit l'annuaire,
                 parc.json et postes.csv, et rien d'autre : il répond à « quels
                 postes existent », pas à « lesquels vont bien ».
                 ============================================================ -->
            <TabItem Header="{x:Static loc:L.ParkTabInventory}" Padding="14,6">
              <Grid Background="#F4F6F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,10" Background="#EDF1F6">
                  <StackPanel>
                    <TextBlock Text="{x:Static loc:L.ParkInvIntro}" TextWrapping="Wrap"
                               FontSize="12" Foreground="#44546A" Margin="0,0,0,8"/>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static loc:L.ParkInvOuLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtUnite" Width="420" VerticalAlignment="Center"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkInvOuTip}"/>
                        <Button x:Name="BtnInvActualiser" Content="{x:Static loc:L.ParkInvRefresh}"
                                Padding="12,5" Margin="8,0,0,0" FontWeight="SemiBold"
                                Click="BtnInvActualiser_Click"
                                ToolTip="{x:Static loc:L.ParkInvRefreshTip}"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static loc:L.ParkInvPickLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="BtnInvListerUnites" Content="{x:Static loc:L.ParkInvListUnits}"
                                Padding="12,5" Margin="0,0,8,0" Click="BtnInvListerUnites_Click"
                                ToolTip="{x:Static loc:L.ParkInvListUnitsTip}"/>
                        <ComboBox x:Name="CbUnite" Width="420" VerticalAlignment="Center" FontSize="12"
                                  IsEnabled="False" SelectionChanged="CbUnite_SelectionChanged"
                                  ToolTip="{x:Static loc:L.ParkInvPickTip}"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{x:Static loc:L.ParkInvMacLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtFichierMac" Width="420" VerticalAlignment="Center"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkInvMacTip}"/>
                        <Button x:Name="BtnInvParcourirMac" Content="{x:Static loc:L.ParkInvBrowse}"
                                Padding="12,5" Margin="8,0,0,0" Click="BtnInvParcourirMac_Click"/>
                    </WrapPanel>
                    <!-- LE SERVEUR DHCP EST UN RÉGLAGE DE LA CONSOLE, pas seulement du
                         script. Le script sait le demander, mais uniquement quand on le
                         lance à la main : piloté par la console il se tait, et la question
                         n'était jamais posée. Voir ParametresParc.ServeurDhcp. -->
                    <WrapPanel VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{x:Static loc:L.ParkInvDhcpLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtServeurDhcp" Width="420" VerticalAlignment="Center"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkInvDhcpTip}"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{x:Static loc:L.ParkInvPackageLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtPaquet" Width="420" VerticalAlignment="Center"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkInvPackageTip}"/>
                        <Button x:Name="BtnInvParcourirPaquet" Content="{x:Static loc:L.ParkInvBrowse}"
                                Padding="12,5" Margin="8,0,0,0" Click="BtnInvParcourirPaquet_Click"/>
                        <TextBlock x:Name="TxtPaquetEtat" VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontSize="12" Foreground="#44546A"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <ListView x:Name="LvInventaire" Grid.Row="1" Margin="0,10" BorderThickness="1"
                          BorderBrush="#DBE2EC" FontSize="12">
                    <ListView.View>
                        <GridView>
                            <!-- AUCUNE CASE N'EST COCHEE AU DEPART : c'est une decision,
                                 pas un oubli. Voir ParkWindow.Inventaire.cs. -->
                            <GridViewColumn Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Coche, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static loc:L.ParkColMachine}" Width="130" DisplayMemberBinding="{Binding Nom}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColSources}" Width="110" DisplayMemberBinding="{Binding Sources}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColHost}" Width="140" DisplayMemberBinding="{Binding Hote}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColUnit}" Width="185" DisplayMemberBinding="{Binding Unite}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColLastLogon}" Width="105" DisplayMemberBinding="{Binding DerniereSession}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColAccount}" Width="85" DisplayMemberBinding="{Binding Compte}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColMac}" Width="85" DisplayMemberBinding="{Binding Mac}"/>
                            <!-- LA COLONNE DU RÉSULTAT EST LA DERNIÈRE, mais c'est celle
                                 qu'on vient lire : la largeur de la fenêtre est calculée
                                 pour qu'elle tienne SANS défilement horizontal. Constaté
                                 le 19/09/2026 — elle était hors de l'écran. -->
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColCheck}" Width="230" DisplayMemberBinding="{Binding Etat}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Grid.Row="2" Background="#EDF1F6" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- DEUX LIGNES AU MAXIMUM. Le texte complet reste accessible au
                             survol : un message qui s'étale sur cinq lignes écrase le
                             tableau, qui est ce qu'on regarde. Constaté le 19/09/2026. -->
                        <TextBlock x:Name="TxtInvStatus" Grid.Column="0" FontSize="12" Foreground="#44546A"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="{x:Static loc:L.ParkInvHint}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnInvReprendre" Content="{x:Static loc:L.ParkInvResume}"
                                    Padding="10,5" FontSize="12" Margin="0,0,10,0"
                                    Click="BtnInvReprendre_Click"
                                    ToolTip="{x:Static loc:L.ParkInvResumeTip}"/>
                            <Button x:Name="BtnInvToutCocher" Content="{x:Static loc:L.ParkInvCheckAll}"
                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="BtnInvToutCocher_Click"/>
                            <Button x:Name="BtnInvRienCocher" Content="{x:Static loc:L.ParkInvUncheckAll}"
                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="BtnInvRienCocher_Click"/>
                            <Button x:Name="BtnInvVerifier" Content="{x:Static loc:L.ParkInvVerify}"
                                    Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                    Background="#2470B3" Foreground="White" BorderThickness="0"
                                    Click="BtnInvVerifier_Click"
                                    ToolTip="{x:Static loc:L.ParkInvVerifyTip}"/>
                            <CheckBox x:Name="ChkModeParc" Content="{x:Static loc:L.ParkInvParkMode}"
                                      IsChecked="True" VerticalAlignment="Center" Margin="14,0,8,0"
                                      FontSize="12" ToolTip="{x:Static loc:L.ParkInvParkModeTip}"/>
                            <Button x:Name="BtnInvDeployer" Content="{x:Static loc:L.ParkInvDeploy}"
                                    Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                    Background="#B33A3A" Foreground="White" BorderThickness="0"
                                    Click="BtnInvDeployer_Click"
                                    ToolTip="{x:Static loc:L.ParkInvDeployTip}"/>
                        </StackPanel>
                    </Grid>
                </Border>
              </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
