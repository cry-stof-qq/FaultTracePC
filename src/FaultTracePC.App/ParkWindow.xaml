<Window x:Class="FaultTracePC.App.ParkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FaultTracePC.App"
        Title="{x:Static loc:L.ParkTitle}"
        Icon="Assets/FaultTracePC.ico"
        Width="960" Height="560" MinWidth="780" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
        Loaded="ParkWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#182848" Padding="16,10">
            <TextBlock Text="{x:Static loc:L.ParkHeader}" Foreground="White"
                       FontSize="15" FontWeight="SemiBold"/>
        </Border>

        <TabControl Grid.Row="1" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">

            <!-- ============================================================
                 SUPERVISION — les machines déjà suivies, interrogées en direct.
                 Contenu inchangé : seuls les numéros de ligne ont bougé, la
                 grille de la fenêtre étant devenue celle de l'onglet.
                 ============================================================ -->
            <TabItem Header="{x:Static loc:L.ParkTabMonitoring}" Padding="14,6">
              <Grid Background="#F4F6F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Secret maître + ajout d'une machine -->
                <Border Grid.Row="0" Padding="14,10" Background="#EDF1F6">
                  <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static loc:L.ParkSecretLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <PasswordBox x:Name="PwdSecret" Width="260" VerticalAlignment="Center"
                                     FontFamily="Consolas" FontSize="11"
                                     ToolTip="{x:Static loc:L.ParkSecretTip}"/>
                        <Button Content="{x:Static loc:L.ParkSecretSave}" Padding="12,5" Margin="8,0,0,0" Click="BtnSecretSave_Click"/>
                        <Button Content="{x:Static loc:L.ParkSecretForget}" Padding="12,5" Margin="8,0,0,0" Click="BtnSecretForget_Click"/>
                        <TextBlock x:Name="TxtSecretEtat" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="12" Foreground="#44546A"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static loc:L.ParkName}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtName" Width="120" VerticalAlignment="Center"
                                 ToolTip="{x:Static loc:L.ParkNameTip}"/>
                        <TextBlock Text="{x:Static loc:L.ParkHost}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtHost" Width="140" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:L.ParkPort}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtPort" Width="60" Text="58620" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:L.ParkToken}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtToken" Width="200" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkTokenTip}"/>
                        <Button Content="{x:Static loc:L.ParkAdd}" Padding="12,5" Margin="12,0,0,0" Click="BtnAdd_Click"/>
                        <Button Content="{x:Static loc:L.ParkRemove}" Padding="12,5" Margin="8,0,0,0" Click="BtnRemove_Click"/>
                        <Button Content="{x:Static loc:L.ParkRefreshAll}" Padding="12,5" Margin="8,0,0,0" FontWeight="SemiBold" Click="BtnRefresh_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <ListView x:Name="LvMachines" Grid.Row="1" Margin="0,10" BorderThickness="1" BorderBrush="#DBE2EC" FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static loc:L.ParkColMachine}" Width="130" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColHost}" Width="130" DisplayMemberBinding="{Binding Host}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColState}" Width="150" DisplayMemberBinding="{Binding Etat}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColVersion}" Width="165" DisplayMemberBinding="{Binding Version}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColLast}" Width="120" DisplayMemberBinding="{Binding DernierReleve}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColCpu}" Width="60" DisplayMemberBinding="{Binding Cpu}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColCpuTemp}" Width="65" DisplayMemberBinding="{Binding TempCpu}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColGpuTemp}" Width="65" DisplayMemberBinding="{Binding TempGpu}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColRam}" Width="60" DisplayMemberBinding="{Binding Ram}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColTop}" Width="230" DisplayMemberBinding="{Binding Top}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Grid.Row="2" Background="#EDF1F6" Padding="14,8">
                    <Grid>
                        <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontSize="12" Foreground="#44546A"
                                   Text="{x:Static loc:L.ParkHint}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnParkReport" Content="{x:Static loc:L.ParkReport}" Padding="12,6"
                                    FontSize="12" Margin="0,0,8,0" Click="BtnParkReport_Click"
                                    ToolTip="{x:Static loc:L.ParkReportTip}"/>
                            <Button x:Name="BtnRemoteScan" Content="{x:Static loc:L.ParkRemoteScan}" Padding="12,6"
                                    FontSize="12" Margin="0,0,8,0" FontWeight="SemiBold"
                                    Background="#2470B3" Foreground="White" BorderThickness="0"
                                    Click="BtnRemoteScan_Click"
                                    ToolTip="{x:Static loc:L.ParkRemoteScanTip}"/>
                            <Button Content="{x:Static loc:L.ParkOpenReport}" Padding="12,6" FontSize="12" Click="BtnOpenReport_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
              </Grid>
            </TabItem>

            <!-- ============================================================
                 INVENTAIRE — point 64, lot A-3.
                 AUCUNE MACHINE N'EST CONTACTÉE ICI. Cet onglet lit l'annuaire,
                 parc.json et postes.csv, et rien d'autre : il répond à « quels
                 postes existent », pas à « lesquels vont bien ».
                 ============================================================ -->
            <TabItem Header="{x:Static loc:L.ParkTabInventory}" Padding="14,6">
              <Grid Background="#F4F6F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,10" Background="#EDF1F6">
                  <StackPanel>
                    <TextBlock Text="{x:Static loc:L.ParkInvIntro}" TextWrapping="Wrap"
                               FontSize="12" Foreground="#44546A" Margin="0,0,0,8"/>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{x:Static loc:L.ParkInvOuLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtUnite" Width="420" VerticalAlignment="Center"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkInvOuTip}"/>
                        <Button x:Name="BtnInvActualiser" Content="{x:Static loc:L.ParkInvRefresh}"
                                Padding="12,5" Margin="8,0,0,0" FontWeight="SemiBold"
                                Click="BtnInvActualiser_Click"
                                ToolTip="{x:Static loc:L.ParkInvRefreshTip}"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static loc:L.ParkInvPickLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="BtnInvListerUnites" Content="{x:Static loc:L.ParkInvListUnits}"
                                Padding="12,5" Margin="0,0,8,0" Click="BtnInvListerUnites_Click"
                                ToolTip="{x:Static loc:L.ParkInvListUnitsTip}"/>
                        <ComboBox x:Name="CbUnite" Width="420" VerticalAlignment="Center" FontSize="12"
                                  IsEnabled="False" SelectionChanged="CbUnite_SelectionChanged"
                                  ToolTip="{x:Static loc:L.ParkInvPickTip}"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{x:Static loc:L.ParkInvMacLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtFichierMac" Width="420" VerticalAlignment="Center"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="{x:Static loc:L.ParkInvMacTip}"/>
                        <Button x:Name="BtnInvParcourirMac" Content="{x:Static loc:L.ParkInvBrowse}"
                                Padding="12,5" Margin="8,0,0,0" Click="BtnInvParcourirMac_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <ListView x:Name="LvInventaire" Grid.Row="1" Margin="0,10" BorderThickness="1"
                          BorderBrush="#DBE2EC" FontSize="12">
                    <ListView.View>
                        <GridView>
                            <!-- AUCUNE CASE N'EST COCHEE AU DEPART : c'est une decision,
                                 pas un oubli. Voir ParkWindow.Inventaire.cs. -->
                            <GridViewColumn Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Coche, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static loc:L.ParkColMachine}" Width="130" DisplayMemberBinding="{Binding Nom}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColSources}" Width="130" DisplayMemberBinding="{Binding Sources}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkColHost}" Width="150" DisplayMemberBinding="{Binding Hote}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColUnit}" Width="200" DisplayMemberBinding="{Binding Unite}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColLastLogon}" Width="120" DisplayMemberBinding="{Binding DerniereSession}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColAccount}" Width="100" DisplayMemberBinding="{Binding Compte}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColMac}" Width="90" DisplayMemberBinding="{Binding Mac}"/>
                            <GridViewColumn Header="{x:Static loc:L.ParkInvColCheck}" Width="200" DisplayMemberBinding="{Binding Etat}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Grid.Row="2" Background="#EDF1F6" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtInvStatus" Grid.Column="0" FontSize="12" Foreground="#44546A"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="{x:Static loc:L.ParkInvHint}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnInvToutCocher" Content="{x:Static loc:L.ParkInvCheckAll}"
                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="BtnInvToutCocher_Click"/>
                            <Button x:Name="BtnInvRienCocher" Content="{x:Static loc:L.ParkInvUncheckAll}"
                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="BtnInvRienCocher_Click"/>
                            <Button x:Name="BtnInvVerifier" Content="{x:Static loc:L.ParkInvVerify}"
                                    Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                    Background="#2470B3" Foreground="White" BorderThickness="0"
                                    Click="BtnInvVerifier_Click"
                                    ToolTip="{x:Static loc:L.ParkInvVerifyTip}"/>
                        </StackPanel>
                    </Grid>
                </Border>
              </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
