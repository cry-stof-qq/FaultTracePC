<Window x:Class="FaultTracePC.App.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FaultTracePC.App"
        Title="{x:Static loc:L.MonTitle}"
        Icon="Assets/FaultTracePC.ico"
        Width="820" Height="560" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre d'options -->
        <Border Grid.Row="0" Background="#182848" Padding="16,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static loc:L.MonHeader}" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkFahrenheit" Content="{x:Static loc:L.MonFahrenheit}" Foreground="#B9C4DC"
                          VerticalAlignment="Center" Margin="24,0,0,0" Checked="Units_Changed" Unchecked="Units_Changed"/>
                <TextBlock x:Name="TxtSensorNote" Foreground="#F5C97B" FontSize="11" Margin="24,0,0,0"
                           VerticalAlignment="Center" Visibility="Collapsed"
                           Text="{x:Static loc:L.MonNoCpuTemp}"/>
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <!-- Onglet 1 : en direct (mode simple) -->
            <TabItem Header="{x:Static loc:L.MonTabLive}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLiveStatus" Grid.Row="0" Margin="4,6" FontSize="12" Foreground="#44546A"
                               Text="{x:Static loc:L.MonLoading}"/>
                    <ListView x:Name="LvLive" Grid.Row="1" BorderThickness="1" BorderBrush="#DBE2EC" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:L.MonColTime}" Width="130" DisplayMemberBinding="{Binding Heure}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColCpu}" Width="70" DisplayMemberBinding="{Binding Cpu}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColCpuTemp}" Width="90" DisplayMemberBinding="{Binding TempCpu}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColGpuTemp}" Width="90" DisplayMemberBinding="{Binding TempGpu}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColRam}" Width="70" DisplayMemberBinding="{Binding Ram}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColInfo}" Width="330" DisplayMemberBinding="{Binding Info}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Onglet 2 : courbes -->
            <TabItem Header="{x:Static loc:L.MonTabCharts}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="4,6">
                        <TextBlock Text="{x:Static loc:L.MonPeriod}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbChartHours" Width="130" SelectedIndex="1" VerticalAlignment="Center"
                                  SelectionChanged="ChartRange_Changed">
                            <ComboBoxItem Content="{x:Static loc:L.Mon1h}" Tag="1"/>
                            <ComboBoxItem Content="{x:Static loc:L.Mon6h}" Tag="6"/>
                            <ComboBoxItem Content="{x:Static loc:L.Mon24h}" Tag="24"/>
                            <ComboBoxItem Content="{x:Static loc:L.Mon7d}" Tag="168"/>
                        </ComboBox>
                        <!-- Légende : identité jamais portée par la couleur seule -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Rectangle Width="14" Height="3" Fill="#2A78D6" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static loc:L.MonCpuTempLabel}" Margin="5,0,16,0" FontSize="12" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="3" Fill="#EB6834" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static loc:L.MonGpuTempLabel}" Margin="5,0,16,0" FontSize="12" VerticalAlignment="Center"/>
                            <Rectangle Width="14" Height="3" Fill="#1BAF7A" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static loc:L.MonMemLabel}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <Border Grid.Row="1" Background="White" BorderBrush="#DBE2EC" BorderThickness="1" Margin="4">
                        <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"
                                Background="Transparent" MouseMove="ChartCanvas_MouseMove" MouseLeave="ChartCanvas_MouseLeave"/>
                    </Border>

                    <TextBlock x:Name="TxtChartInfo" Grid.Row="2" Margin="6,2,6,6" FontSize="12" Foreground="#44546A"
                               Text="{x:Static loc:L.MonChartHint}"/>
                </Grid>
            </TabItem>

            <!-- Onglet 3 : historique agrégé par heure (tableau = vue alternative des courbes) -->
            <TabItem Header="{x:Static loc:L.MonTabHistory}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="4,6">
                        <TextBlock Text="{x:Static loc:L.MonPeriod}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbHistDays" Width="110" SelectedIndex="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="{x:Static loc:L.Mon24h}" Tag="1"/>
                            <ComboBoxItem Content="{x:Static loc:L.MonHist3d}" Tag="3"/>
                            <ComboBoxItem Content="{x:Static loc:L.Mon7d}" Tag="7"/>
                            <ComboBoxItem Content="{x:Static loc:L.MonHist14d}" Tag="14"/>
                        </ComboBox>
                        <Button Content="{x:Static loc:L.MonLoad}" Padding="12,5" Margin="10,0,0,0" Click="BtnLoadHistory_Click"/>
                        <TextBlock x:Name="TxtHistStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontSize="12" Foreground="#44546A"/>
                    </WrapPanel>
                    <ListView x:Name="LvHist" Grid.Row="1" BorderThickness="1" BorderBrush="#DBE2EC" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{x:Static loc:L.MonColTime}" Width="120" DisplayMemberBinding="{Binding Periode}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColCpuAvg}" Width="85" DisplayMemberBinding="{Binding CpuMoy}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColCpuMax}" Width="85" DisplayMemberBinding="{Binding CpuMax}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColCpuTempMax}" Width="90" DisplayMemberBinding="{Binding TempCpuMax}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColGpuTempMax}" Width="90" DisplayMemberBinding="{Binding TempGpuMax}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColRamMax}" Width="85" DisplayMemberBinding="{Binding RamMax}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColCommitMax}" Width="115" DisplayMemberBinding="{Binding CommitMax}"/>
                                <GridViewColumn Header="{x:Static loc:L.MonColEvents}" Width="100" DisplayMemberBinding="{Binding Evenements}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Onglet 4 : données brutes (mode avancé) -->
            <TabItem Header="{x:Static loc:L.MonTabRaw}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="4,6">
                        <Button Content="{x:Static loc:L.MonRefresh}" Padding="12,5" Click="BtnRawRefresh_Click"/>
                        <TextBlock x:Name="TxtRawPath" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontSize="11" Foreground="#6B7C91"/>
                    </WrapPanel>
                    <TextBox x:Name="TxtRaw" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="#182848" Foreground="#D8E4F5" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
