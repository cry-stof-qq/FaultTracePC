<Window x:Class="FaultTracePC.App.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaultTracePC — Surveillance en direct"
        Width="820" Height="560" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre d'options -->
        <Border Grid.Row="0" Background="#182848" Padding="16,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="📈 Journal de la boîte noire" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkFahrenheit" Content="Afficher en Fahrenheit (°F)" Foreground="#B9C4DC"
                          VerticalAlignment="Center" Margin="24,0,0,0" Checked="Units_Changed" Unchecked="Units_Changed"/>
                <TextBlock x:Name="TxtSensorNote" Foreground="#F5C97B" FontSize="11" Margin="24,0,0,0"
                           VerticalAlignment="Center" Visibility="Collapsed"
                           Text="ℹ La température CPU n'est pas exposée par les capteurs de cette machine."/>
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <!-- Onglet 1 : en direct (mode simple) -->
            <TabItem Header="  En direct  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLiveStatus" Grid.Row="0" Margin="4,6" FontSize="12" Foreground="#44546A"
                               Text="Chargement du journal…"/>
                    <ListView x:Name="LvLive" Grid.Row="1" BorderThickness="1" BorderBrush="#DBE2EC" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Heure" Width="130" DisplayMemberBinding="{Binding Heure}"/>
                                <GridViewColumn Header="CPU %" Width="70" DisplayMemberBinding="{Binding Cpu}"/>
                                <GridViewColumn Header="Temp. CPU" Width="90" DisplayMemberBinding="{Binding TempCpu}"/>
                                <GridViewColumn Header="Temp. GPU" Width="90" DisplayMemberBinding="{Binding TempGpu}"/>
                                <GridViewColumn Header="RAM %" Width="70" DisplayMemberBinding="{Binding Ram}"/>
                                <GridViewColumn Header="Infos (événements, processus…)" Width="330" DisplayMemberBinding="{Binding Info}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Onglet 2 : historique agrégé par heure -->
            <TabItem Header="  Historique  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="4,6">
                        <TextBlock Text="Période :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbHistDays" Width="110" SelectedIndex="1" VerticalAlignment="Center">
                            <ComboBoxItem Content="24 heures" Tag="1"/>
                            <ComboBoxItem Content="3 jours" Tag="3"/>
                            <ComboBoxItem Content="7 jours" Tag="7"/>
                            <ComboBoxItem Content="14 jours" Tag="14"/>
                        </ComboBox>
                        <Button Content="Charger" Padding="12,5" Margin="10,0,0,0" Click="BtnLoadHistory_Click"/>
                        <TextBlock x:Name="TxtHistStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontSize="12" Foreground="#44546A"/>
                    </WrapPanel>
                    <ListView x:Name="LvHist" Grid.Row="1" BorderThickness="1" BorderBrush="#DBE2EC" FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Heure" Width="120" DisplayMemberBinding="{Binding Periode}"/>
                                <GridViewColumn Header="CPU moy %" Width="85" DisplayMemberBinding="{Binding CpuMoy}"/>
                                <GridViewColumn Header="CPU max %" Width="85" DisplayMemberBinding="{Binding CpuMax}"/>
                                <GridViewColumn Header="T° CPU max" Width="90" DisplayMemberBinding="{Binding TempCpuMax}"/>
                                <GridViewColumn Header="T° GPU max" Width="90" DisplayMemberBinding="{Binding TempGpuMax}"/>
                                <GridViewColumn Header="RAM max %" Width="85" DisplayMemberBinding="{Binding RamMax}"/>
                                <GridViewColumn Header="Mém. virt. max %" Width="115" DisplayMemberBinding="{Binding CommitMax}"/>
                                <GridViewColumn Header="Événements" Width="100" DisplayMemberBinding="{Binding Evenements}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Onglet 3 : données brutes (mode avancé) -->
            <TabItem Header="  Données brutes (avancé)  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="4,6">
                        <Button Content="Actualiser" Padding="12,5" Click="BtnRawRefresh_Click"/>
                        <TextBlock x:Name="TxtRawPath" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontSize="11" Foreground="#6B7C91"/>
                    </WrapPanel>
                    <TextBox x:Name="TxtRaw" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="#182848" Foreground="#D8E4F5" Padding="8"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
