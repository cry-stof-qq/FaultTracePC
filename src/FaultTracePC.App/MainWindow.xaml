<Window x:Class="FaultTracePC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaultTracePC — Diagnostic de pannes Windows"
        Width="760" Height="560" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bandeau -->
        <Border Grid.Row="0" Background="#182848" Padding="22,16">
            <StackPanel>
                <TextBlock Text="FaultTracePC" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Trouver la cause d'une panne Windows 10/11 — scan post-mortem et surveillance temps réel"
                           Foreground="#B9C4DC" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Commandes -->
        <Border Grid.Row="1" Padding="22,16,22,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnScan" Content="🔍  Analyser cette machine" Padding="16,9"
                        FontSize="14" FontWeight="SemiBold"
                        Background="#2470B3" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnScan_Click"/>
                <TextBlock Text="Période :" VerticalAlignment="Center" Margin="18,0,6,0"/>
                <ComboBox x:Name="CmbDays" Width="110" VerticalAlignment="Center" SelectedIndex="1">
                    <ComboBoxItem Content="7 jours" Tag="7"/>
                    <ComboBoxItem Content="30 jours" Tag="30"/>
                    <ComboBoxItem Content="90 jours" Tag="90"/>
                </ComboBox>
                <CheckBox x:Name="ChkDrivers" Content="Inventaire des pilotes" IsChecked="True"
                          VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button x:Name="BtnRealtime" Content="📡  Surveillance temps réel" Padding="14,9" Margin="18,0,0,0"
                        FontSize="13" IsEnabled="False" Cursor="Arrow"
                        ToolTip="Disponible en Phase 3 : service de surveillance avec journal continu et capteurs de température."/>
            </StackPanel>
        </Border>

        <!-- Résultats -->
        <Grid Grid.Row="2" Margin="22,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TxtStatus" Text="Prêt. Lance l'analyse pour examiner dumps, journaux d'événements, fiabilité et état matériel."
                           FontSize="13" Foreground="#44546A" TextWrapping="Wrap"/>
                <ProgressBar x:Name="PbProgress" Height="8" Margin="0,8,0,10" Minimum="0" Maximum="100"
                             Visibility="Collapsed"/>
                <Border x:Name="VerdictBorder" Visibility="Collapsed" CornerRadius="7" Padding="12,9" Margin="0,0,0,10"
                        BorderThickness="1">
                    <TextBlock x:Name="TxtVerdict" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <ListView x:Name="LstFindings" Grid.Row="1" BorderThickness="1" BorderBrush="#DBE2EC"
                      Background="White" Visibility="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding BadgeBrush}" CornerRadius="9" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#44546A"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Pied -->
        <Border Grid.Row="3" Background="#EDF1F6" Padding="22,10">
            <Grid>
                <TextBlock x:Name="TxtFoot" Text="v0.1 — Phase 1 (scan post-mortem)" FontSize="11" Foreground="#6B7C91"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRepair" Content="🛠  Lancer la réparation" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" IsEnabled="False" Click="BtnRepair_Click"
                            Background="#27AE60" Foreground="White" BorderThickness="0"
                            ToolTip="Exécute le script PowerShell de réparation généré par le dernier scan (tests en lecture seule automatiques, actions avec confirmation O/N)."/>
                    <Button x:Name="BtnOpenReport" Content="📄  Ouvrir le dernier rapport"
                            Padding="12,6" FontSize="12" IsEnabled="False" Click="BtnOpenReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
