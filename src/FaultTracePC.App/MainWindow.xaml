<Window x:Class="FaultTracePC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaultTracePC — Diagnostic de pannes Windows"
        Icon="Assets/FaultTracePC.ico"
        Width="880" Height="580" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bandeau -->
        <Border Grid.Row="0" Background="#182848" Padding="22,16">
            <StackPanel>
                <TextBlock Text="FaultTracePC" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Trouver la cause d'une panne Windows 10/11 — scan post-mortem et surveillance temps réel"
                           Foreground="#B9C4DC" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Commandes : WrapPanel = retour à la ligne automatique, plus jamais de bouton
             poussé hors de la fenêtre quand on ajoute une option. -->
        <Border Grid.Row="1" Padding="22,16,22,8">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BtnScan" Content="🔍  Analyser cette machine" Padding="16,9"
                        FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"
                        Background="#2470B3" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnScan_Click"/>
                <Button x:Name="BtnRealtime" Content="📡  Surveillance temps réel" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnRealtime_Click"
                        ToolTip="Installe/désinstalle le service boîte noire : journal continu (températures, mémoire, événements) écrit sur disque pour retrouver les secondes précédant un crash. Moins de 1 % de CPU."/>
                <Button x:Name="BtnViewer" Content="📈  Voir en direct" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnViewer_Click"
                        ToolTip="Ouvre le visualiseur du journal : relevés en direct (CPU, températures), historique sur plusieurs jours, données brutes, bascule °C/°F."/>
                <Button x:Name="BtnNetwork" Content="🌐  Réseau" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnNetwork_Click"
                        ToolTip="Mode réseau de cette machine : Local (rien d'exposé) ou Client (télémétrie et rapports en lecture seule, réservés aux adresses privées munies du token)."/>
                <Button x:Name="BtnPark" Content="🖥  Parc" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnPark_Click"
                        ToolTip="Console maître : état temps réel et rapports de toutes tes machines clientes."/>
                <Button x:Name="BtnGuided" Content="🧭  Je ne sais pas ce que j'ai" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnGuided_Click"
                        Background="#7D3C98" Foreground="White" BorderThickness="0"
                        ToolTip="Assistant guidé : point de restauration, analyse, réparations sans risque, puis vérification. Une conclusion en une phrase, et les actions qui demandent ton accord proposées une par une."/>
                <Button x:Name="BtnToolbox" Content="🧰  Outils" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnToolbox_Click"
                        ToolTip="Boîte à outils de réparation : désinstaller une mise à jour Windows, réinitialiser Windows Update, sfc/DISM/chkdsk, diagnostic mémoire… à un clic, dans une fenêtre PowerShell visible."/>
                <TextBlock Text="Période :" VerticalAlignment="Center" Margin="18,0,6,6"/>
                <ComboBox x:Name="CmbDays" Width="110" VerticalAlignment="Center" SelectedIndex="1" Margin="0,0,0,6">
                    <ComboBoxItem Content="7 jours" Tag="7"/>
                    <ComboBoxItem Content="30 jours" Tag="30"/>
                    <ComboBoxItem Content="90 jours" Tag="90"/>
                </ComboBox>
                <CheckBox x:Name="ChkDrivers" Content="Inventaire des pilotes" IsChecked="True"
                          VerticalAlignment="Center" Margin="18,0,0,6"/>
                <CheckBox x:Name="ChkDeep" Content="Analyse profonde (WinDbg)" IsChecked="True"
                          VerticalAlignment="Center" Margin="12,0,0,6"
                          ToolTip="Exécute !analyze -v sur les 5 derniers dumps via CDB pour nommer le pilote fautif. Nécessite WinDbg (winget install Microsoft.WinDbg) ; ignoré proprement s'il est absent."/>
            </WrapPanel>
        </Border>

        <!-- Résultats -->
        <Grid Grid.Row="2" Margin="22,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TxtStatus" Text="Prêt. Lance l'analyse pour examiner dumps, journaux d'événements, fiabilité et état matériel."
                           FontSize="13" Foreground="#44546A" TextWrapping="Wrap"/>
                <ProgressBar x:Name="PbProgress" Height="8" Margin="0,8,0,10" Minimum="0" Maximum="100"
                             Visibility="Collapsed"/>
                <Border x:Name="VerdictBorder" Visibility="Collapsed" CornerRadius="7" Padding="12,9" Margin="0,0,0,10"
                        BorderThickness="1">
                    <TextBlock x:Name="TxtVerdict" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <ListView x:Name="LstFindings" Grid.Row="1" BorderThickness="1" BorderBrush="#DBE2EC"
                      Background="White" Visibility="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding BadgeBrush}" CornerRadius="9" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#44546A"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Pied -->
        <Border Grid.Row="3" Background="#EDF1F6" Padding="22,10">
            <!-- Deux colonnes plutôt qu'une seule superposition : sans elles, le bloc
                 de gauche et les boutons alignés à droite occupent la MÊME cellule et
                 se chevauchent dès que la fenêtre est un peu étroite. La colonne
                 gauche est élastique et son texte se tronque ; les boutons, eux,
                 gardent toujours leur largeur. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- WrapPanel et non StackPanel : une Grid délimite des colonnes mais
                     ne DÉCOUPE pas ce qui déborde. Un StackPanel horizontal continue
                     tout droit hors de sa colonne et se fait recouvrir par le bloc de
                     droite, déclaré après lui. Le WrapPanel, lui, replie ses éléments
                     sur une seconde ligne dès que la place manque : le pied grandit
                     un peu, mais plus rien n'est masqué. ClipToBounds ferme le sujet
                     dans le cas extrême d'une fenêtre réduite au minimum. -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                           Margin="0,0,12,0" ClipToBounds="True">
                    <TextBlock x:Name="TxtFoot" Text="v1.1 — diagnostic et réparation" FontSize="11" Foreground="#6B7C91"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,2"
                               MaxWidth="340"
                               ToolTip="Diagnostic des pannes, boîte noire temps réel, alertes préventives, console de parc et aide à la réparation."/>
                    <TextBlock x:Name="TxtUpdate" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                               Visibility="Collapsed" FontWeight="SemiBold" Foreground="#C0392B"/>
                    <Button x:Name="BtnUpdate" Content="🔄 Vérifier les mises à jour" FontSize="11" Padding="8,3"
                            Margin="14,2,0,2" VerticalAlignment="Center" Click="BtnUpdate_Click"
                            ToolTip="Interroge la page des versions publiées sur GitHub. FaultTracePC ne télécharge et n'installe jamais rien tout seul : il te dit ce qui existe, tu décides."/>
                    <CheckBox x:Name="ChkUpdateStartup" Content="au démarrage" FontSize="11" Margin="8,2,0,2"
                              VerticalAlignment="Center" Foreground="#6B7C91"
                              Checked="ChkUpdateStartup_Changed" Unchecked="ChkUpdateStartup_Changed"
                              ToolTip="Décoché par défaut : sans cette case, FaultTracePC ne contacte jamais Internet de lui-même. À laisser décoché sur un poste d'établissement si les sorties réseau sont contrôlées."/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnRepair" Content="🛠  Lancer la réparation" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" IsEnabled="False" Click="BtnRepair_Click"
                            Background="#27AE60" Foreground="White" BorderThickness="0"
                            ToolTip="Exécute le script PowerShell de réparation généré par le dernier scan (tests en lecture seule automatiques, actions avec confirmation O/N)."/>
                    <Button x:Name="BtnPdf" Content="📑  PDF" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" IsEnabled="False" Click="BtnPdf_Click"
                            ToolTip="Crée un PDF du dernier rapport, à la demande uniquement — aucun PDF n'est généré automatiquement. Le document contient le rapport COMPLET, détails techniques inclus, pour être joint à un ticket ou transmis à un réparateur."/>
                    <Button x:Name="BtnOpenReport" Content="📄  Ouvrir le dernier rapport"
                            Padding="12,6" FontSize="12" IsEnabled="False" Click="BtnOpenReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
