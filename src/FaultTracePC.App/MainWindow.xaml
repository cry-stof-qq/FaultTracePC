<Window x:Class="FaultTracePC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FaultTracePC.App"
        Title="{x:Static loc:L.MainTitle}"
        Icon="Assets/FaultTracePC.ico"
        Width="880" Height="580" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bandeau -->
        <Border Grid.Row="0" Background="#182848" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FaultTracePC" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static loc:L.MainTagline}"
                               Foreground="#B9C4DC" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Sélecteur de langue. Le libellé affiche la langue ACTIVE (FR/EN),
                         la coche du menu marque la PRÉFÉRENCE enregistrée : les deux
                         diffèrent tant qu'un changement n'a pas été suivi d'un
                         redémarrage, et prétendre le contraire serait mentir. -->
                    <Button x:Name="BtnLang" Content="FR" MinWidth="34" Height="30"
                            FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"
                            Background="#2470B3" Foreground="White" BorderThickness="0"
                            Click="BtnLang_Click" ToolTip="{x:Static loc:L.LangTip}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MnuLang">
                                <MenuItem x:Name="MiLangFr" Header="{x:Static loc:L.LangFrench}"
                                          IsCheckable="True" Tag="fr" Click="MiLang_Click"/>
                                <MenuItem x:Name="MiLangEn" Header="{x:Static loc:L.LangEnglish}"
                                          IsCheckable="True" Tag="en" Click="MiLang_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MiLangAuto" Header="{x:Static loc:L.LangAuto}"
                                          IsCheckable="True" Tag="auto" Click="MiLang_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Version installée : la première question posée à quelqu'un qui
                         signale un problème, et jusqu'ici invisible depuis l'interface. -->
                    <Button x:Name="BtnAbout" Content="?" Width="30" Height="30"
                            FontSize="15" FontWeight="Bold" Cursor="Hand"
                            Background="#2470B3" Foreground="White"
                            BorderThickness="0" Click="BtnAbout_Click"
                            ToolTip="{x:Static loc:L.MainAboutTip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Commandes : WrapPanel = retour à la ligne automatique, plus jamais de bouton
             poussé hors de la fenêtre quand on ajoute une option. -->
        <Border Grid.Row="1" Padding="22,16,22,8">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BtnScan" Content="{x:Static loc:L.MainScan}" Padding="16,9"
                        FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"
                        Background="#2470B3" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnScan_Click"/>
                <Button x:Name="BtnRealtime" Content="{x:Static loc:L.MainMonitor}" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnRealtime_Click"
                        ToolTip="{x:Static loc:L.MainMonitorTip}"/>
                <Button x:Name="BtnViewer" Content="{x:Static loc:L.MainLive}" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnViewer_Click"
                        ToolTip="{x:Static loc:L.MainLiveTip}"/>
                <Button x:Name="BtnNetwork" Content="{x:Static loc:L.MainNetwork}" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnNetwork_Click"
                        ToolTip="{x:Static loc:L.MainNetworkTip}"/>
                <Button x:Name="BtnPark" Content="{x:Static loc:L.MainFleet}" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnPark_Click"
                        ToolTip="{x:Static loc:L.MainFleetTip}"/>
                <Button x:Name="BtnGuided" Content="{x:Static loc:L.MainGuided}" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnGuided_Click"
                        Background="#7D3C98" Foreground="White" BorderThickness="0"
                        ToolTip="{x:Static loc:L.MainGuidedTip}"/>
                <Button x:Name="BtnToolbox" Content="{x:Static loc:L.MainTools}" Padding="14,9" Margin="12,0,0,6"
                        FontSize="13" Cursor="Hand" Click="BtnToolbox_Click"
                        ToolTip="{x:Static loc:L.MainToolsTip}"/>
                <TextBlock Text="{x:Static loc:L.MainPeriod}" VerticalAlignment="Center" Margin="18,0,6,6"/>
                <ComboBox x:Name="CmbDays" Width="110" VerticalAlignment="Center" SelectedIndex="1" Margin="0,0,0,6">
                    <ComboBoxItem Content="{x:Static loc:L.MainDays7}" Tag="7"/>
                    <ComboBoxItem Content="{x:Static loc:L.MainDays30}" Tag="30"/>
                    <ComboBoxItem Content="{x:Static loc:L.MainDays90}" Tag="90"/>
                </ComboBox>
                <CheckBox x:Name="ChkDrivers" Content="{x:Static loc:L.MainDriverInventory}" IsChecked="True"
                          VerticalAlignment="Center" Margin="18,0,0,6"/>
                <CheckBox x:Name="ChkDeep" Content="{x:Static loc:L.MainDeepAnalysis}" IsChecked="True"
                          VerticalAlignment="Center" Margin="12,0,0,6"
                          ToolTip="{x:Static loc:L.MainDeepAnalysisTip}"/>
            </WrapPanel>
        </Border>

        <!-- Résultats -->
        <Grid Grid.Row="2" Margin="22,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TxtStatus" Text="{x:Static loc:L.MainReady}"
                           FontSize="13" Foreground="#44546A" TextWrapping="Wrap"/>
                <ProgressBar x:Name="PbProgress" Height="8" Margin="0,8,0,10" Minimum="0" Maximum="100"
                             Visibility="Collapsed"/>
                <Border x:Name="VerdictBorder" Visibility="Collapsed" CornerRadius="7" Padding="12,9" Margin="0,0,0,10"
                        BorderThickness="1">
                    <TextBlock x:Name="TxtVerdict" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <ListView x:Name="LstFindings" Grid.Row="1" BorderThickness="1" BorderBrush="#DBE2EC"
                      Background="White" Visibility="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding BadgeBrush}" CornerRadius="9" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#44546A"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Pied -->
        <Border Grid.Row="3" Background="#EDF1F6" Padding="22,10">
            <!-- Deux colonnes plutôt qu'une seule superposition : sans elles, le bloc
                 de gauche et les boutons alignés à droite occupent la MÊME cellule et
                 se chevauchent dès que la fenêtre est un peu étroite. La colonne
                 gauche est élastique et son texte se tronque ; les boutons, eux,
                 gardent toujours leur largeur. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- WrapPanel et non StackPanel : une Grid délimite des colonnes mais
                     ne DÉCOUPE pas ce qui déborde. Un StackPanel horizontal continue
                     tout droit hors de sa colonne et se fait recouvrir par le bloc de
                     droite, déclaré après lui. Le WrapPanel, lui, replie ses éléments
                     sur une seconde ligne dès que la place manque : le pied grandit
                     un peu, mais plus rien n'est masqué. ClipToBounds ferme le sujet
                     dans le cas extrême d'une fenêtre réduite au minimum. -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                           Margin="0,0,12,0" ClipToBounds="True">
                    <TextBlock x:Name="TxtFoot" Text="" FontSize="11" Foreground="#6B7C91"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,2"
                               MaxWidth="340"
                               ToolTip="{x:Static loc:L.MainFooterTip}"/>
                    <TextBlock x:Name="TxtUpdate" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                               Visibility="Collapsed" FontWeight="SemiBold" Foreground="#C0392B"/>
                    <Button x:Name="BtnUpdate" Content="{x:Static loc:L.MainCheckUpdates}" FontSize="11" Padding="8,3"
                            Margin="14,2,0,2" VerticalAlignment="Center" Click="BtnUpdate_Click"
                            ToolTip="{x:Static loc:L.MainCheckUpdatesTip}"/>
                    <CheckBox x:Name="ChkUpdateStartup" Content="{x:Static loc:L.MainAtStartup}" FontSize="11" Margin="8,2,0,2"
                              VerticalAlignment="Center" Foreground="#6B7C91"
                              Checked="ChkUpdateStartup_Changed" Unchecked="ChkUpdateStartup_Changed"
                              ToolTip="{x:Static loc:L.MainAtStartupTip}"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnRepair" Content="{x:Static loc:L.MainRunRepair}" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" IsEnabled="False" Click="BtnRepair_Click"
                            Background="#27AE60" Foreground="White" BorderThickness="0"
                            ToolTip="{x:Static loc:L.MainRunRepairTip}"/>
                    <Button x:Name="BtnPdf" Content="{x:Static loc:L.MainPdf}" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" IsEnabled="False" Click="BtnPdf_Click"
                            ToolTip="{x:Static loc:L.MainPdfTip}"/>
                    <Button x:Name="BtnOpenReport" Content="{x:Static loc:L.MainOpenReport}"
                            Padding="12,6" FontSize="12" IsEnabled="False" Click="BtnOpenReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
