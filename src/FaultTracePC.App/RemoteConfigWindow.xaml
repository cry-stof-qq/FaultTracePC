<Window x:Class="FaultTracePC.App.RemoteConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FaultTracePC.App"
        Title="{x:Static loc:L.NetTitle}"
        Icon="Assets/FaultTracePC.ico"
        Width="640" Height="480" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:L.NetHeader}" FontSize="17" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <RadioButton x:Name="RbLocal" Content="{x:Static loc:L.NetLocal}"
                         GroupName="Mode" FontSize="13" Margin="0,4"/>
            <RadioButton x:Name="RbClient" Content="{x:Static loc:L.NetClient}"
                         GroupName="Mode" FontSize="13" Margin="0,4"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,10,0,0" x:Name="PnlClient">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:L.NetPort}" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="TxtPort" Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                     VerticalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:L.NetMachine}" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="TxtMachine" Grid.Row="1" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas"
                     FontSize="12" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"
                     VerticalAlignment="Center" Margin="0,0,0,8"
                     ToolTip="{x:Static loc:L.NetMachineTip}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:L.NetSecret}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <PasswordBox x:Name="PwdSecret" Grid.Row="2" Grid.Column="1" FontFamily="Consolas"
                         FontSize="11" VerticalAlignment="Center"
                         ToolTip="{x:Static loc:L.NetSecretTip}"/>

            <TextBlock x:Name="TxtEtat" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap"
                       FontSize="11" Foreground="#44546A" Margin="0,6,0,0"/>
        </Grid>

        <Border Grid.Row="3" Background="#FFFBE9" BorderBrush="#E8D9A0" BorderThickness="1" CornerRadius="8"
                Padding="12" Margin="0,14,0,0" VerticalAlignment="Top">
            <!-- Le texte est en Run liés : un TextBlock au contenu écrit en clair
                 ne peut pas changer de langue, et c'est exactement le défaut que
                 cette fenêtre portait. Les mots en gras restent en gras. -->
            <TextBlock FontSize="12" TextWrapping="Wrap">
                <Bold><Run Text="{x:Static loc:L.NetSecTitle}"/></Bold><Run Text="{x:Static loc:L.NetSecA}"/><Bold><Run Text="{x:Static loc:L.NetSecOr}"/></Bold><Run Text="{x:Static loc:L.NetSecB}"/><Bold><Run Text="{x:Static loc:L.NetSecNever}"/></Bold><Run Text="{x:Static loc:L.NetSecC}"/><LineBreak/><LineBreak/>
                <Bold><Run Text="{x:Static loc:L.NetClockTitle}"/></Bold><Run Text="{x:Static loc:L.NetClockBody}"/><LineBreak/><LineBreak/>
                <Bold><Run Text="{x:Static loc:L.NetMasterTitle}"/></Bold><Run Text="{x:Static loc:L.NetMasterBody}"/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" Foreground="#44546A"/>
            <Button Content="{x:Static loc:L.NetApply}" Padding="16,7" FontWeight="SemiBold" Background="#2470B3" Foreground="White"
                    BorderThickness="0" Click="BtnApply_Click"/>
            <Button Content="{x:Static loc:L.NetClose}" Padding="16,7" Margin="8,0,0,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
