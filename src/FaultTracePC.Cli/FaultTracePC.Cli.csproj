<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>FaultTracePC.Cli</AssemblyName>
    <RootNamespace>FaultTracePC.Cli</RootNamespace>
    <Version>1.4.1</Version>
    <Product>FaultTracePC CLI</Product>
    <Description>Diagnostic FaultTracePC en ligne de commande (déploiement de parc)</Description>

    <!-- Élévation requise : lecture des dumps et des journaux complets. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\FaultTracePC.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaultTracePC.Core\FaultTracePC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le projet de tests exerce l'analyse de la ligne de commande. -->
    <InternalsVisibleTo Include="FaultTracePC.Tests" />
  </ItemGroup>

</Project>
